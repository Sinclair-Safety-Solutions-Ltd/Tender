# Resend transactional email
# EMAIL_FROM must use a domain verified in Resend, or every send is rejected.
# Both are per-environment: staging and production use separate keys and senders.
RESEND_API_KEY=""
# Must be a verified Resend sender, e.g. Trade Tender <notifications@your-domain>.
# Placeholder values such as "test" are treated as unset and block verification email.
EMAIL_FROM=""
REGISTRATION_NOTIFICATION_EMAIL=""
# PostgreSQL. For Neon, DATABASE_URL should be pooled and DATABASE_URL_UNPOOLED direct.
# Local development via docker compose can use the same direct URL for both.
DATABASE_URL="postgresql://tender:devpassword@localhost:5432/tender_dev?schema=public"
DATABASE_URL_UNPOOLED="postgresql://tender:devpassword@localhost:5432/tender_dev?schema=public"

# Production rate limiting uses only this header (Render overwrites x-real-ip).
# Omit locally so development can still read x-forwarded-for.
TRUSTED_CLIENT_IP_HEADER=""

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Required for signed native mobile access tokens. Set a separate random value per environment.
MOBILE_AUTH_SECRET="replace-with-a-separate-long-random-string"
# Required in every environment: the full public origin of this deployment.
# Email links, Stripe redirect URLs, and the same-origin API check all derive from it.
NEXTAUTH_URL="http://localhost:3000"
# Optional. Comma-separated extra origins this deployment also answers on, such as a custom domain.
ADDITIONAL_ALLOWED_ORIGINS=""

# Public support address shown in the footer and policies page. The links are hidden when unset.
NEXT_PUBLIC_SUPPORT_EMAIL=""

# Set both values only for a deployed sandbox. Never enable sandbox seeding in production.
TRADE_TENDER_ENV=""
SANDBOX_SEED_ENABLED="false"
SANDBOX_USER_PASSWORD=""

# Local platform owner seed account (do not commit the password)
PLATFORM_OWNER_EMAIL=""
PLATFORM_OWNER_PASSWORD=""

# Stripe (leave blank locally — payments fall back to dev-mode confirmation)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Secret for the scheduled 30-day quote retention job
RETENTION_JOB_SECRET="replace-with-a-long-random-string"

# Private file storage. Production must set a durable directory or an object location.
# The default data/attachments path is rejected when NODE_ENV=production.
# STORAGE_DRIVER=filesystem
# ATTACHMENT_STORE_DIR="/var/data/documents"
# ATTACHMENT_TEMP_DIR="/var/data/documents-temporary"
# ATTACHMENT_ARCHIVE_DIR="/var/data/documents-archive"
# STORAGE_RETENTION_ACTION=delete
# STORAGE_DIRECT_URLS=false
# Object location (driver name stays s3 for the generic HTTP object API):
# STORAGE_DRIVER=s3
# OBJECT_STORE_ENDPOINT=""
# OBJECT_STORE_BUCKET=""
# OBJECT_STORE_ARCHIVE_BUCKET=""
# OBJECT_STORE_REGION="auto"
# OBJECT_STORE_ACCESS_KEY_ID=""
# OBJECT_STORE_SECRET_ACCESS_KEY=""
# OBJECT_STORE_FORCE_PATH_STYLE="true"
# Or replace the three locations with JSON. Credentials are read from the named env vars.
# STORAGE_LOCATIONS=""

# Sentry. Leave blank to disable the SDK entirely (it initialises as a no-op).
# The NEXT_PUBLIC_ DSN is exposed to the browser by design; it is not a secret.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
SENTRY_ENVIRONMENT="development"
# Build-time only, for source map upload. Never commit this.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
