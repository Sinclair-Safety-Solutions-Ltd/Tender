{
  "name": "construction-tender-saas",
  "version": "0.1.0",
  "description": "UK Construction Tendering Marketplace - Prototype",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "tsx --test tests/lib/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:restore-initial-partners": "tsx --env-file=.env scripts/restore-initial-partners.ts",
    "db:seed-fake-tenders": "tsx --env-file=.env scripts/seed-fake-tenders.ts",
    "db:seed-demo-scenarios": "tsx --env-file=.env scripts/seed-demo-scenarios.ts",
    "db:repair-sandbox": "tsx --env-file=.env scripts/repair-sandbox-walkthrough.ts",
    "db:verify-owner-password": "tsx --env-file=.env scripts/verify-owner-password.ts",
    "retention:purge": "tsx --env-file=.env scripts/purge-retention.ts",
    "storage:export": "tsx --env-file=.env scripts/export-stored-objects.ts",
    "storage:backfill": "tsx --env-file=.env scripts/backfill-legacy-object-bytes.ts",
    "storage:relocate": "tsx --env-file=.env scripts/relocate-storage-location.ts",
    "pricing:refresh-estimates": "tsx --env-file=.env scripts/refresh-quote-estimate-baselines.ts",
    "health:audit": "node scripts/health-check/run-audit.mjs",
    "health:validate-workflows": "node scripts/health-check/validate-workflows.mjs",
    "health:verify-approval": "node scripts/health-check/verify-approval.mjs",
    "health:verify-deploy-approval": "node scripts/health-check/verify-deployment-approval.mjs",
    "health:verify-deployment": "node scripts/health-check/verify-deployment.mjs",
    "health:email": "tsx scripts/health-check/send-report-email.ts",
    "stress-test": "node scripts/stress-test/run.mjs",
    "mobile-stress-test": "node scripts/mobile/run-stress-test.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.1",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/nextjs": "^10.72.0",
    "autoprefixer": "^10.4.16",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "jose": "^6.2.11",
    "lucide-react": "^1.40.0",
    "nanoid": "^3.3.18",
    "next": "^16.3.8",
    "next-auth": "^4.24.15",
    "otplib": "^13.5.0",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.4.31",
    "prisma": "6.19.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^2.10.3",
    "resend": "^6.24.0",
    "sharp": "^0.35.5",
    "stripe": "^22.6.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.3.0",
    "zod": "^4.4.3",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "axe-core": "^4.10.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.8",
    "tsx": "^4.23.12"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "fast-uri": "3.1.8",
    "source-map-js": "1.2.2"
  }
}
