// Single datasource for every environment: PostgreSQL locally and Neon Lakebase Postgres in staging/production.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  SUPER_USER
  USER
}

enum TenderStatus {
  DRAFT
  OPEN
  CLOSED
}

enum UnlockMethod {
  CREDIT
  PAID
  WAIVED
}

enum QuoteStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum AttachmentKind {
  DRAWING
  SPECIFICATION
  RAMS
  METHOD_STATEMENT
  INSURANCE
  OTHER
}

enum LegalHoldScope {
  TENDER
  QUOTE
  TENDER_ATTACHMENT
}

enum PaymentType {
  RETAILER_UNLOCK
  CLIENT_RELEASE
  SPONSORED_PLACEMENT
  MEMBERSHIP_TIER
  INDEPENDENT_REVIEW
  DIRECT_CONTACT
  PROFESSIONAL_INTEREST
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
  REVERSED
}

enum PaymentReversalType {
  REFUND
  DISPUTE
}

enum ModerationDecision {
  ALLOW
  WARN
  BLOCK
  REVIEW
}

enum SupportRequestType {
  SUPPORT
  CHANGE
  PAYMENT
  DATA_PRIVACY
}

enum SupportRequestStatus {
  SUBMITTED
  TRIAGED
  INFORMATION_REQUESTED
  APPROVED
  REJECTED
  RESOLVED
}

enum DataSubjectRequestRight {
  ACCESS_EXPORT
  RECTIFICATION
  ERASURE
  RESTRICTION
  OBJECTION
}

enum ProviderVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum CompanyType {
  SOLE_TRADER
  LIMITED_COMPANY
  PARTNERSHIP
  LIMITED_LIABILITY_PARTNERSHIP
  PUBLIC_LIMITED_COMPANY
  OTHER
}

enum IndependentReviewStatus {
  NOT_PURCHASED
  PURCHASED
  APPROVED
  DECLINED
}

enum IndependentReviewTier {
  BRONZE
  SILVER
  GOLD
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  failedLoginAttempts Int    @default(0)
  loginLockedUntil  DateTime?
  sessionVersion    Int      @default(0)
  role              Role
  isOwner           Boolean  @default(false)
  isAccountant      Boolean  @default(false)
  contactName       String
  firstName         String?
  lastName          String?
  contactPhone      String?
  suspended         Boolean  @default(false)
  emailVerifiedAt   DateTime?
  mustChangePassword Boolean @default(false)
  termsAcceptedAt   DateTime?
  termsVersion      String?
  privacyAcceptedAt DateTime?
  privacyVersion    String?
  mfaEnabled        Boolean  @default(false)
  mfaSecretEncrypted String?
  mfaRecoveryCodesHash String?
  mfaVerifiedAt     DateTime?
  createdAt         DateTime @default(now())
  lastLoginAt       DateTime?
  lastLogoutAt      DateTime?
  totalTimeOnlineSeconds Int @default(0)

  mobileDevices     MobileDevice[]
  pageViews         PageView[]

  retailerProfile   RetailerProfile?
  primaryClientCompany ClientCompany? @relation("ClientCompanyPrimary")
  clientCompanyMembership ClientCompanyMember?
  roleMemberships   UserRole[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  enhancedVerificationInvitations EnhancedVerificationInvitation[] @relation("UserEnhancedVerificationInvitations")
  masterOfRetailers RetailerProfile[] @relation("MasterUser")
  teamMember        RetailerTeamMember?
  tenders           Tender[]        @relation("ClientTenders")
  quotes            Quote[]         @relation("RetailerQuotes")
  unlocks           Unlock[]        @relation("RetailerUnlocks")
  itemMatches       TenderItemMatch[] @relation("RetailerItemMatches")
  payments          Payment[]
  memberships       RetailerMembership[]
  subscriptions     RetailerSubscription[]
  sponsoredPlacements RetailerSponsoredPlacement[]
  auditLogs         AuditLog[]
  sentTenderMessages TenderMessage[] @relation("TenderMessageSender")
  retailerMessages TenderMessage[] @relation("TenderMessageRetailer")
  clientMessages TenderMessage[] @relation("TenderMessageClient")
  professionalInterests ProfessionalInterest[]
  directContactRequests DirectContactRequest[] @relation("DirectContactRequester")
  moderationEvents  ModerationEvent[] @relation("ModerationActor")
  reviewedModerationEvents ModerationEvent[] @relation("ModerationReviewer")
  legalHoldsCreated LegalHold[] @relation("LegalHoldCreatedBy")
  legalHoldsReleased LegalHold[] @relation("LegalHoldReleasedBy")
  supportRequests SupportRequest[] @relation("SupportRequester")
  reviewedSupportRequests SupportRequest[] @relation("SupportReviewer")
  paymentWaivers PaymentWaiver[] @relation("PaymentWaiverUser")
  grantedPaymentWaivers PaymentWaiver[] @relation("PaymentWaiverGrantedBy")
  revokedPaymentWaivers PaymentWaiver[] @relation("PaymentWaiverRevokedBy")
  receivedTenderWarnings TenderWarning[] @relation("TenderWarningRecipient")
  issuedTenderWarnings TenderWarning[] @relation("TenderWarningIssuer")
  projectsCreated   Project[] @relation("ProjectCreator")
  awardsGiven       Award[]   @relation("AwardActor")
  controlChangesProposed ControlChange[] @relation("ControlChangeProposer")
  controlChangesConfirmed ControlChange[] @relation("ControlChangeConfirmer")
  marketingCampaignsCreated MarketingCampaign[] @relation("MarketingCampaignCreator")
}

model MobileDevice {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform          String
  refreshTokenHash  String    @unique
  authVersion       Int
  biometricEnabled  Boolean   @default(true)
  revokedAt         DateTime?
  lastUsedAt        DateTime?
  createdAt         DateTime  @default(now())
  expiresAt         DateTime

  @@index([userId, revokedAt])
}

model RateLimitEntry {
  identifierHash String   @id
  scope          String
  windowStartedAt DateTime
  requestCount   Int      @default(0)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([expiresAt])
}

/** In-app route visits, used only to show a Super User which areas an account has been using. */
model PageView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  path      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model ModerationEvent {
  id           String             @id @default(cuid())
  actorId      String
  actor        User               @relation("ModerationActor", fields: [actorId], references: [id])
  contentType  String
  contentHash  String
  decision     ModerationDecision
  riskScore    Int
  reasons      String
  entities     String
  reviewSnapshot String?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?              @relation("ModerationReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?
  reviewOutcome String?
  compensationAwardedAt DateTime?
  compensationCredits Int @default(0)
  compensationType String?
  createdAt    DateTime           @default(now())

  @@index([decision, createdAt])
  @@index([actorId, createdAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

enum EnhancedVerificationInvitationStatus {
  PENDING
  USED
  EXPIRED
  REVOKED
}

model EnhancedVerificationInvitation {
  id                    String                              @id @default(cuid())
  userId                String
  user                  User                                @relation("UserEnhancedVerificationInvitations", fields: [userId], references: [id], onDelete: Cascade)
  paymentId             String
  payment               Payment                             @relation("PaymentEnhancedVerificationInvitations", fields: [paymentId], references: [id], onDelete: Cascade)
  recipientEmail        String
  recipientName         String?
  moduleCode            String                              @default("VERIFICATION")
  productCode           String                              @default("ENHANCED_VERIFICATION")
  tokenHash             String                              @unique
  status                EnhancedVerificationInvitationStatus @default(PENDING)
  expiresAt             DateTime
  usedAt                DateTime?
  createdAt             DateTime                            @default(now())

  @@index([userId, expiresAt])
  @@index([paymentId])
  @@index([recipientEmail])
}

model ClientCompany {
  id            String   @id @default(cuid())
  tradeTenderId String?  @unique
  companyName   String
  branchIdentifier String @default("Head Office")
  companyType   CompanyType @default(LIMITED_COMPANY)
  services      String   @default("")
  serviceProvisions String @default("")
  operatingLocations String @default("")
  primaryUserId String   @unique
  primaryUser   User     @relation("ClientCompanyPrimary", fields: [primaryUserId], references: [id])
  releaseCreditsLeft Int  @default(0)
  releaseSpendCapGbp Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members ClientCompanyMember[]
  projects Project[]

  @@unique([companyName, branchIdentifier])
}

model ClientCompanyMember {
  id        String        @id @default(cuid())
  companyId String
  userId    String        @unique
  company   ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  duties    String        @default("RAISER,ESTIMATOR,APPROVER,AUDITOR")
  createdAt DateTime      @default(now())

  @@unique([companyId, userId])
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model QuoteEstimateBaseline {
  id                 String   @id @default(cuid())
  key                String   @unique
  service            String
  category           String
  item               String?
  standardUnit       String   @default("unit")
  standardUnitSize   Float    @default(1)
  baselineGbp        Float
  observedUnitPriceGbp Float?
  automaticOffsetPercent Float @default(0)
  manualOffsetPercent Float?
  offsetMode         String   @default("AUTOMATIC")
  sampleSize         Int
  reviewedAt         DateTime
  effectiveWeekStart DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([service, category])
  @@index([effectiveWeekStart])
  @@index([reviewedAt])
}

model Partner {
  id              String   @id @default(cuid())
  name            String   @unique
  logoPath        String
  destinationUrl  String?
  displayLocation String
  campaignSource  String?
  sortOrder       Int      @default(0)
  active          Boolean  @default(false)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([displayLocation, active, expiresAt, sortOrder])
}

model CategoryDefinition {
  id        String   @id @default(cuid())
  service   String
  name      String
  itemsJson String
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([service, name])
}

model MembershipTier {
  id                              String   @id @default(cuid())
  name                            String   @unique
  description                     String
  monthlyPriceGbp                 Int
  freeTenderOpportunitiesPerMonth Int      @default(0)
  additionalCreditDiscountPercentage Float  @default(0)
  active                          Boolean  @default(false)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
  retailers      RetailerMembership[]
  payments       Payment[] @relation("MembershipTierPayments")
}

model RetailerMembership {
  id         String         @id @default(cuid())
  retailerId String
  retailer   User           @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  tierId     String
  tier       MembershipTier @relation(fields: [tierId], references: [id])
  paymentId  String?        @unique
  payment    Payment?       @relation(fields: [paymentId], references: [id])
  active     Boolean        @default(true)
  assignedAt DateTime       @default(now())
  expiresAt  DateTime?

  @@unique([retailerId, tierId])
}

model SubscriptionPlan {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String
  annualPriceGbp Int
  active         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  subscriptions  RetailerSubscription[]
}

model RetailerSubscription {
  id         String           @id @default(cuid())
  retailerId String
  retailer   User             @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  planId     String
  plan       SubscriptionPlan @relation(fields: [planId], references: [id])
  active     Boolean          @default(true)
  startedAt  DateTime         @default(now())

  @@unique([retailerId, planId])
}

model RetailerSponsoredPlacement {
  id          String   @id @default(cuid())
  retailerId  String
  retailer    User     @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  paymentId   String?  @unique
  payment     Payment? @relation(fields: [paymentId], references: [id])
  active      Boolean  @default(true)
  purchasedAt DateTime @default(now())
  expiresAt   DateTime?

  @@index([retailerId, active, expiresAt])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())

  @@unique([userId, role])
}

enum RetailerPermission {
  VIEW
  EDIT
  SUPER_USER
  PAYMENTS
}

enum RetailerCoverageScope {
  COUNTY
  REGION
  UK
}

model RetailerProfile {
  id                String                @id @default(cuid())
  userId            String                @unique
  user              User                  @relation(fields: [userId], references: [id])
  masterUserId      String?
  masterUser        User?                 @relation("MasterUser", fields: [masterUserId], references: [id])
  companyName       String
  companyNumber     String?
  address           String?
  companyType       CompanyType           @default(LIMITED_COMPANY)
  isSoleTrader      Boolean               @default(false) // kept in sync with companyType == SOLE_TRADER for existing call sites
  coverageScope     RetailerCoverageScope @default(COUNTY)
  counties          String                @default("") // comma-separated UK county names, used when coverageScope = COUNTY
  regions           String                @default("") // comma-separated UK region names, used when coverageScope = REGION
  categories        String                // comma-separated category names
  coverageAreas     String                // comma-separated postcode areas / towns, used for distance estimates only
  accreditations    String?
  standardQuoteValidityDays Int           @default(30)
  launchCreditsLeft Int                   @default(3)
  launchCreditsExpireAt DateTime?
  launchCreditsReason   String?
  verificationStatus     ProviderVerificationStatus @default(UNVERIFIED)
  verificationRequestedAt DateTime?
  verificationDecidedAt   DateTime?
  verificationNote        String?
  verificationConfidencePercent Int?
  verificationReport      String? // AI + review summary; Super User visibility only, never returned to the Provider
  independentReviewStatus IndependentReviewStatus @default(NOT_PURCHASED)
  independentReviewTier IndependentReviewTier?
  independentReviewPurchasedTier IndependentReviewTier?
  independentReviewPurchasedPaymentId String?
  independentReviewPurchasedPayment Payment? @relation("IndependentReviewPurchasedPayment", fields: [independentReviewPurchasedPaymentId], references: [id], onDelete: SetNull)
  independentReviewPurchasedAt DateTime?
  independentReviewDecidedAt   DateTime?
  independentReviewNote        String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @default(now())

  teamMembers       RetailerTeamMember[]
  verificationDocuments VerificationDocument[]

  @@index([independentReviewPurchasedPaymentId])
}

enum ProviderVerificationDocumentType {
  CERTIFICATE_OF_INCORPORATION
  PUBLIC_LIABILITY_INSURANCE
  EMPLOYERS_LIABILITY_INSURANCE
  WASTE_CARRIERS_LICENCE
  PROFESSIONAL_QUALIFICATIONS
  PROFESSIONAL_INDEMNITY_INSURANCE
  SSIP_ACCREDITATION
  HMRC_UTR_CONFIRMATION
  SA302_TAX_CALCULATION
  VAT_REGISTRATION_CERTIFICATE
  CIS_REGISTRATION_PROOF
  BUSINESS_BANK_STATEMENT
  CUSTOMER_INVOICES
  CUSTOMER_QUOTATIONS_OR_CONTRACTS
  TRADE_BODY_MEMBERSHIP
  TRADING_ACTIVITY_EVIDENCE
}

/** One uploaded evidence file per document type/slot; re-uploading replaces the prior file for that slot. */
model StoredObject {
  id           String   @id @default(cuid())
  storageKey   String
  locationId   String
  fileName     String
  mimeType     String
  sizeBytes    Int
  checksum     String
  purpose      String
  tenantId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenderAttachment       TenderAttachment?
  verificationDocument   VerificationDocument?

  @@unique([locationId, storageKey])
  @@index([tenantId, purpose, createdAt])
}

model VerificationDocument {
  id                String                           @id @default(cuid())
  retailerProfileId String
  retailerProfile   RetailerProfile                  @relation(fields: [retailerProfileId], references: [id], onDelete: Cascade)
  documentType      ProviderVerificationDocumentType
  fileName          String
  mimeType          String
  sizeBytes         Int
  objectKey         String?
  checksum          String?
  locationId        String?
  tenantId          String?
  storedObjectId    String?                          @unique
  storedObject      StoredObject?                    @relation(fields: [storedObjectId], references: [id], onDelete: SetNull)
  expiryDate        DateTime?
  aiConfidencePercent Int?
  aiSummary           String? // Super User visibility only, never returned to the Provider
  aiRequiresHumanReview Boolean @default(false)
  aiAssessedAt          DateTime?
  verified              Boolean @default(false) // set true for every applicable document present at the moment the profile is approved
  uploadedAt        DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt

  @@unique([retailerProfileId, documentType])
}

model RetailerTeamMember {
  id                String   @id @default(cuid())
  retailerId        String
  retailerProfile   RetailerProfile @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  permissions       String   // comma-separated permission names
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([retailerId, userId])
}

model Project {
  id          String   @id @default(cuid())
  companyId   String
  company     ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  location    String
  createdById String
  createdBy   User     @relation("ProjectCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenders     Tender[]
  awards      Award[]

  @@unique([companyId, name])
  @@index([companyId, createdAt])
}

model Tender {
  id            String       @id @default(cuid())
  reference     String       @unique
  clientId      String
  client        User         @relation("ClientTenders", fields: [clientId], references: [id])
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  category      String
  subcategory   String
  service       String   @default("Materials")
  item          String?
  location      String
  quantity      String
  urgency       String
  closingDate   DateTime
  supplyDate    DateTime?
  requirements  String       // comma-separated tick-box requirements
  description   String
  status        TenderStatus @default(OPEN)
  allowDirectContact Boolean @default(false)
  allowProfessionalInterest Boolean @default(false)
  createdAt     DateTime     @default(now())

  packages      TenderPackage[]
  matches       TenderMatch[]
  unlocks       Unlock[]
  unlockPayments Payment[] @relation("TenderUnlockPayments")
  quotes        Quote[]
  items         TenderItem[]
  attachments   TenderAttachment[]
  messages      TenderMessage[]
  professionalInterests ProfessionalInterest[]
  directContactRequests DirectContactRequest[]
  legalHolds    LegalHold[] @relation("LegalHoldTender")
  warnings      TenderWarning[]
  awards        Award[]

  @@index([status, closingDate])
  @@index([category, subcategory, status])
  @@index([projectId])
  @@index([clientId, status, closingDate])
}

model TenderWarning {
  id          String   @id @default(cuid())
  tenderId    String
  tender      Tender   @relation(fields: [tenderId], references: [id], onDelete: Restrict)
  recipientId String
  recipient   User     @relation("TenderWarningRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  issuedById  String
  issuedBy    User     @relation("TenderWarningIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  reason      String
  note        String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([recipientId, active, createdAt])
  @@index([tenderId, createdAt])
}

model TenderPackage {
  id           String       @id @default(cuid())
  tenderId     String
  tender       Tender       @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  reference    String       @unique
  category     String
  subcategory  String
  service      String       @default("Materials")
  item         String?
  location     String
  quantity     String
  urgency      String
  closingDate  DateTime
  supplyDate   DateTime?
  requirements String       // comma-separated tick-box requirements
  description  String
  specJson     String       @default("{}")
  revision     Int          @default(1)
  specHash     String       @default("")
  issuedAt     DateTime?
  packageIndex Int          @default(0)
  status       TenderStatus @default(OPEN)
  createdAt    DateTime     @default(now())

  @@index([tenderId, status, createdAt])
  @@index([tenderId, packageIndex])
  @@index([category])
}

model TenderMessage {
  id         String   @id @default(cuid())
  tenderId   String
  tender     Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  retailerId String
  retailer   User     @relation("TenderMessageRetailer", fields: [retailerId], references: [id])
  clientId   String
  client     User     @relation("TenderMessageClient", fields: [clientId], references: [id])
  senderId   String
  sender     User     @relation("TenderMessageSender", fields: [senderId], references: [id])
  body       String
  createdAt  DateTime @default(now())

  @@index([tenderId, retailerId, createdAt])
}

model TenderAttachment {
  id          String   @id @default(cuid())
  tenderId    String
  tender      Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  fileName    String
  mimeType    String
  sizeBytes   Int
  kind        AttachmentKind @default(OTHER)
  version     Int      @default(1)
  packageIndex Int?
  objectKey   String?
  checksum    String?
  locationId  String?
  tenantId    String?
  storedObjectId String? @unique
  storedObject StoredObject? @relation(fields: [storedObjectId], references: [id], onDelete: SetNull)
  uploadedAt  DateTime @default(now())
  retentionLockedUntil DateTime?
  legalHolds  LegalHold[] @relation("LegalHoldTenderAttachment")

  @@index([tenderId, kind])
}

model TenderItem {
  id          String   @id @default(cuid())
  tenderId    String
  tender      Tender   @relation(fields: [tenderId], references: [id])
  category    String
  subcategory String
  item        String?
  quantity    String
  quantityValue Float?
  unit        String?
  description String
  specJson    String   @default("{}")
  packageIndex Int     @default(0)
  createdAt   DateTime @default(now())
  matches     TenderItemMatch[]
  quoteLines  QuoteLine[]

  @@index([tenderId, packageIndex])
  @@index([category])
}

model TenderItemMatch {
  id         String     @id @default(cuid())
  tenderItemId String
  tenderItem TenderItem @relation(fields: [tenderItemId], references: [id], onDelete: Cascade)
  retailerId String
  retailer   User       @relation("RetailerItemMatches", fields: [retailerId], references: [id])
  notifiedAt DateTime   @default(now())

  @@unique([tenderItemId, retailerId])
  @@index([retailerId])
}

model TenderMatch {
  id         String    @id @default(cuid())
  tenderId   String
  tender     Tender    @relation(fields: [tenderId], references: [id])
  retailerId String
  notifiedAt DateTime  @default(now())
  viewedAt   DateTime?

  @@unique([tenderId, retailerId])
  @@index([retailerId, notifiedAt])
  @@index([retailerId, viewedAt])
}

model Unlock {
  id         String       @id @default(cuid())
  tenderId   String
  tender     Tender       @relation(fields: [tenderId], references: [id])
  retailerId String
  retailer   User         @relation("RetailerUnlocks", fields: [retailerId], references: [id])
  method     UnlockMethod
  paymentId  String?      @unique
  payment    Payment?     @relation(fields: [paymentId], references: [id])
  unlockedAt DateTime     @default(now())

  @@unique([tenderId, retailerId])
  @@index([retailerId])
}

model Quote {
  id           String      @id @default(cuid())
  reference    String      @unique
  tenderId     String
  tender       Tender      @relation(fields: [tenderId], references: [id])
  retailerId   String
  retailer     User        @relation("RetailerQuotes", fields: [retailerId], references: [id])
  priceGbp     Int
  leadTimeDays Int
  deliveryDateConfirmed Boolean @default(false)
  deliveryInfo String
  validityDays Int
  status       QuoteStatus @default(SUBMITTED)
  submittedAt  DateTime    @default(now())
  retentionLockedUntil DateTime?
  verificationDeclarationAcceptedAt DateTime?
  packageSpecHash String @default("")

  releases     ContactRelease[]
  releasePayment Payment? @relation("QuoteReleasePayment")
  lines        QuoteLine[]
  charges      QuoteCharge[]
  legalHolds   LegalHold[] @relation("LegalHoldQuote")
  award        Award?

  @@index([retailerId, submittedAt])
  @@index([tenderId, status])
}

model LegalHold {
  id           String         @id @default(cuid())
  scope        LegalHoldScope
  targetId     String
  reason       String
  createdById  String
  createdBy    User           @relation("LegalHoldCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime       @default(now())
  releasedById String?
  releasedBy   User?          @relation("LegalHoldReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  releasedAt   DateTime?
  releaseReason String?
  tenderId     String?
  tender       Tender?        @relation("LegalHoldTender", fields: [tenderId], references: [id], onDelete: SetNull)
  quoteId      String?
  quote        Quote?         @relation("LegalHoldQuote", fields: [quoteId], references: [id], onDelete: SetNull)
  attachmentId String?
  attachment   TenderAttachment? @relation("LegalHoldTenderAttachment", fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([tenderId, releasedAt])
  @@index([quoteId, releasedAt])
  @@index([attachmentId, releasedAt])
}

model QuoteCharge {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  priceGbp    Int

  @@index([quoteId])
}

model Award {
  id              String   @id @default(cuid())
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tenderId        String
  tender          Tender   @relation(fields: [tenderId], references: [id], onDelete: Restrict)
  quoteId         String   @unique
  quote           Quote    @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  packageSpecHash String
  awardedById     String
  awardedBy       User     @relation("AwardActor", fields: [awardedById], references: [id])
  purchaseOrderNumber String @default("")
  awardedAt       DateTime @default(now())

  @@index([tenderId, awardedAt])
  @@index([projectId])
}

model QuoteLine {
  id           String     @id @default(cuid())
  quoteId      String
  quote        Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  tenderItemId String
  tenderItem   TenderItem @relation(fields: [tenderItemId], references: [id])
  priceGbp     Int?
  unitRateGbp  Float?
  quantityValue Float?
  unit         String?
  pricingKind  String     @default("LUMP")
  available    Boolean    @default(true)

  @@unique([quoteId, tenderItemId])
  @@index([tenderItemId])
}

model Payment {
  id                    String        @id @default(cuid())
  type                  PaymentType
  amountGbp             Float
  vatPercentage         Float                 @default(0)
  vatGbp                Float                 @default(0)
  totalAmountGbp        Float                 @default(0)
  status                PaymentStatus @default(PENDING)
  userId                String
  user                  User          @relation(fields: [userId], references: [id])
  tenderId              String?
  tender                Tender?       @relation("TenderUnlockPayments", fields: [tenderId], references: [id])
  tierId                String?
  tier                  MembershipTier? @relation("MembershipTierPayments", fields: [tierId], references: [id])
  contractMonths        Int?
  stripePaymentIntentId String?       @unique
  stripeCheckoutSessionId String?     @unique
  stripeCheckoutUrl     String?
  stripeEventId         String?       @unique
  stripeReceiptUrl      String?
  accountingRecordPath  String?
  quoteId               String?       @unique
  independentReviewTier IndependentReviewTier?
  paymentWaiverId       String?
  paymentWaiver         PaymentWaiver? @relation(fields: [paymentWaiverId], references: [id], onDelete: Restrict)
  createdAt             DateTime      @default(now())
  confirmedAt           DateTime?

  unlock                Unlock?
  quote                 Quote?        @relation("QuoteReleasePayment", fields: [quoteId], references: [id])
  releases              ContactRelease[]
  sponsoredPlacement    RetailerSponsoredPlacement?
  retailerMembership    RetailerMembership?
  directContactRequest  DirectContactRequest?
  professionalInterest  ProfessionalInterest?
  reversals             PaymentReversal[]
  stripeEvents          StripeEvent[]
  enhancedVerificationInvitations EnhancedVerificationInvitation[] @relation("PaymentEnhancedVerificationInvitations")
  independentReviewEntitlements RetailerProfile[] @relation("IndependentReviewPurchasedPayment")

  @@index([paymentWaiverId])
}

model PaymentReversal {
  id              String              @id @default(cuid())
  paymentId       String
  payment         Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type            PaymentReversalType
  stripeEventId   String              @unique
  providerObjectId String?
  reversedAt      DateTime            @default(now())

  @@index([paymentId, reversedAt])
}

/** Append-only Stripe webhook ledger. Duplicate provider event IDs are rejected by uniqueness. */
model StripeEvent {
  id               String   @id @default(cuid())
  stripeEventId    String   @unique
  type             String
  stripeObjectId   String
  paymentId        String?
  payment          Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  currency         String?
  amountTotalPence Int?
  receivedAt       DateTime @default(now())

  @@index([paymentId, receivedAt])
  @@index([stripeObjectId])
}

model ContactRelease {
  id                  String   @id @default(cuid())
  tenderId            String
  quoteId             String?  @unique
  quote               Quote?   @relation(fields: [quoteId], references: [id])
  clientId            String
  retailerId          String
  releasedAt          DateTime @default(now())
  authorizingPaymentId String?
  authorizingPayment  Payment? @relation(fields: [authorizingPaymentId], references: [id])

  @@unique([tenderId, retailerId])
  @@index([tenderId, clientId])
}

model ContactReleaseAuditEvent {
  id                   String   @id @default(cuid())
  contactReleaseId     String   @unique
  actorId              String
  tenderId             String
  quoteId              String?  @unique
  clientId             String
  retailerId           String
  releasedDataCategory String
  releasedAt           DateTime
  authorizingPaymentId String?
  correlationId        String   @unique
  createdAt            DateTime @default(now())

  @@index([authorizingPaymentId])
  @@index([clientId, retailerId])
}

model ProfessionalInterest {
  id          String   @id @default(cuid())
  tenderId    String
  tender      Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  retailerId  String
  retailer    User     @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  paymentId   String?  @unique
  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  interestedAt DateTime @default(now())
  releasedAt  DateTime?

  @@unique([tenderId, retailerId])
  @@index([tenderId, releasedAt])
}

model DirectContactRequest {
  id          String   @id @default(cuid())
  tenderId    String
  tender      Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User     @relation("DirectContactRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  paymentId   String?  @unique
  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  releasedAt  DateTime?
  createdAt   DateTime @default(now())

  @@unique([tenderId, requesterId])
  @@index([tenderId, releasedAt])
  @@index([requesterId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  metadata   String?
  createdAt  DateTime @default(now())
}

model ControlChange {
  id             String   @id @default(cuid())
  kind           String
  settingKey     String?
  proposedValue  String
  payloadJson    String   @default("{}")
  proposedById   String
  proposedBy     User     @relation("ControlChangeProposer", fields: [proposedById], references: [id])
  confirmedById  String?
  confirmedBy    User?    @relation("ControlChangeConfirmer", fields: [confirmedById], references: [id])
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  confirmedAt    DateTime?
  rejectedAt     DateTime?

  @@index([status, createdAt])
  @@index([kind, status])
}

model SupportRequest {
  id          String               @id @default(cuid())
  requesterId String
  requester   User                 @relation("SupportRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  type        SupportRequestType
  dataSubjectRight DataSubjectRequestRight?
  status      SupportRequestStatus @default(SUBMITTED)
  title       String
  description String
  dueAt       DateTime?
  reviewerId  String?
  reviewer    User?                @relation("SupportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote  String?
  triageCategory String?
  escalationLevel String?
  informationRequestedAt DateTime?
  resolutionEvidence String?
  reviewedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([requesterId, createdAt])
  @@index([status, type, createdAt])
  @@index([dataSubjectRight, dueAt])
}

model PaymentWaiver {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation("PaymentWaiverUser", fields: [userId], references: [id], onDelete: Restrict)
  feeType          PaymentType
  reason           String
  grantedById      String
  grantedBy        User        @relation("PaymentWaiverGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  grantedAt        DateTime    @default(now())
  expiresAt        DateTime?
  revokedById      String?
  revokedBy        User?       @relation("PaymentWaiverRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  revokedAt        DateTime?
  revocationReason String?
  payments         Payment[]

  @@index([userId, feeType, revokedAt, expiresAt])
}

model MarketingCampaign {
  id                      String   @id @default(cuid())
  name                    String
  templateKey             String   @default("MARKETPLACE")
  fileName                String
  ctaUrl                  String?
  status                  String   @default("DRAFT")
  createdById             String
  createdBy               User     @relation("MarketingCampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lawfulBasisConfirmedAt  DateTime?
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  recipients              MarketingCampaignRecipient[]

  @@index([createdById, createdAt])
  @@index([status, createdAt])
}

model MarketingCampaignRecipient {
  id         String    @id @default(cuid())
  campaignId String
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email      String
  status     String    @default("PENDING")
  error      String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  @@unique([campaignId, email])
  @@index([campaignId, status])
}

model MarketingUnsubscribe {
  id              String   @id @default(cuid())
  email           String   @unique
  unsubscribedAt  DateTime @default(now())
  source          String
}
